# Copy to .env and fill in from your Supabase project
# (Project Settings → API). The anon key is public by design; never put
# the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Make image on this computer only (npm run dev). A Google AI Studio key;
# SECRET — no VITE_ prefix, so it never reaches the browser. The live
# site's key is a Cloudflare secret instead (docs/DEPLOY.md).
GEMINI_API_KEY=
# Optional: the image model (default gemini-3-pro-image-preview).
# GEMINI_IMAGE_MODEL=
